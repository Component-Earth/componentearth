{% set custom_class = "bg-[#C0D5EA]" %}

<section class="{{ block.slug ?? 'two-column-buttons' }} {{ custom_class }}">
    {% if fields.anchor|length > 0 or custom_id %}
        <div class="section-anchor" id="{{ custom_id ?? fields.anchor }}"></div>
    {% endif %}

    {% set pt = fields.padding_top and fields.padding_top != "unset" ? fields.padding_top : "st-xs" %}
    {% set pb = fields.padding_top and fields.padding_bottom != "unset" ? fields.padding_bottom : "sb-xs" %}

    <div class="container">
        <div class="{{ pt }} {{ pb }}">                                 
            <div class="flex flex-col items-start gap-sm">
                
                {% if fields.heading %}
                    <{{ fields.heading.type }} class="text-center 2xl:w-[36.6875rem] lg:w-1/2 w-full leading-[90%] text-[var(--theme-color-dark)] font-tertiary-700 [&_p]:!~text-[2.625rem]/[5.15625rem] [&_p]:leading-none [&_strong]:bg-[#FABC6F] [&_strong]:p-[0.25rem] [&_strong]:font-normal [&_strong]:text-primary-dark max-lg:text-left">
                        {{ fields.heading.value }}
                    </{{ fields.heading.type }}>
                {% endif %}


                {% if fields.content %}
                    <div class="grid {% if fields.content|length == 2 %} lg:grid-cols-2 {% else %} lg:grid-cols-1 {% endif %} gap-[2rem] w-full">
                        {% for content in fields.content %}
                            {% if content.link.url|length > 0 %}
                                {% set custom_class = 'btn-primary' %}							
                            
                                {% include 'components/cta.twig' with {
                                'class' : custom_class,
                                'cta': content.link, 
                                'icon': true,
                                'is_btn': true
                                } %}
                            {% endif %}
                        {% endfor %}
                    </div>
                {% endif %}
            </div>     
        </div>
    </div>
</section>