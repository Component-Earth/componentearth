{% set custom_class = "bg-[#DBD5C6] ~pb-[2.5rem]/[4rem]" %}

<section id="filter-block" class="{{ block.slug ?? 'filter-block' }} {{ custom_class }}">
    {% if fields.anchor|length > 0 or custom_id %}
        <div class="section-anchor" id="{{ custom_id ?? fields.anchor }}"></div>
    {% endif %}

    {% set pt = fields.padding_top and fields.padding_top != "unset" ? fields.padding_top : "st-xxl" %}
    {% set pb = fields.padding_top and fields.padding_bottom != "unset" ? fields.padding_bottom : "sb-xxl" %}

    <div class="filter-container container max-md:!pr-0">                               
        <div class="flex flex-col items-start text-left gap-sm [&_ul]:list-none [&_ul]:flex  [&_ul]:gap-[1rem] [&_ul_li]:p-0 [&_ul_li]:before:hidden [&_ul_li]:font-mono [&_ul_li]:text-[0.75rem] [&_select]:min-w-[10rem]">           
    
            <div id="loading" class="hidden font-mono text-[1rem] text-black">Loading...</div>
            
            <div  id="cardGrid" class="card-grid w-full relative">
                {% set i = 0 %}

                {% if (custom_query) %}
                    <div class="lg:grid flex flex-col ~gap-[3rem]/[1.75rem] max-lg:py-[4rem]">
                        {% for list in custom_query.posts %}
                            {% set i = i + 1 %}
                            {% set custom_block = function('get_field', 'block', list.ID) %}
                            {% set custom_excerpt = custom_block.excerpt %}
                            {% set post_type = function('get_post_type', list.ID) %}

                            {# {% set excerpt = custom_excerpt ? custom_excerpt : function('get_the_excerpt', list.ID) %}
                            {% set excerpt_sub = function('substr', excerpt, 0, 1060) %}
                            {% set result = function('substr', excerpt_sub, 0, function('strrpos', excerpt_sub, ' ')) %} #}
                            {% set temp_content = list.post_content %}
                            {% set temp_result = function('wp_trim_words', temp_content, 50) %}

                            {% set post_date = function('get_the_date', 'M j, Y', list.ID ) %}

                            {% set post_thumb_id = function('get_post_thumbnail_id', list.ID) %}
                            {% set custom_image = function('wp_get_attachment_image_src', post_thumb_id, 'full') %}
                            {% set image = custom_image ? custom_image[0] : "" %}  

                            <div class="gap-[1.75rem] flex max-lg:flex-col items-start justify-between relative group w-full card {% if i % 2 == 0 %} lg:flex-row-reverse {% endif %}" data-id="{{ terms[0].term_id }}">
                                <a href="{{ function('the_permalink', list.ID) }}" class="absolute top-0 left-0 w-full h-full z-10"></a>
                                <div class="flex flex-col justify-between gap-[1.75rem] w-full lg:flex-1 lg:pt-[4rem] max-md:pr-[1.25rem]">
                                    <div class="flex flex-col gap-[1.75rem]">
                                        <div class="flex flex-col gap-[0.75rem] relative">
                                            <div class="relative">
                                                <div class=" text-[10rem] lg:absolute lg:top-[-3rem] max-lg:leading-none {% if i % 2 == 0 %} lg:left-[-1rem] {% else %} lg:left-[-3rem] {% endif %} relative text-[#025294] opacity-20">
                                                    0{{ i }}
                                                </div>
                                                <div class="lg:hidden flex absolute top-[60px] left-[40px] py-[1rem] gap-[2rem] items-center text-primary font-tertiary text-[1.25rem] font-bold capitalize">
                                                    <div class="w-[10rem] h-[2px] bg-primary"></div> {{ post_type }}
                                                </div>
                                            </div>
                                            
                                            <div class="lg:p-[3rem] flex flex-col gap-[1.5rem]">
                                                <div class="lg:flex hidden py-[1rem] gap-[2rem] items-center text-primary font-tertiary text-[1.25rem] font-bold capitalize">
                                                    <div class="w-[10rem] h-[2px] bg-primary"></div> {{ post_type }}
                                                </div>
                                                <h2 class="text-primary-dark lg:max-w-[70%] mb-[1rem] leading-none">{{ list.post_title }} </h2>
                                                <div class="font-tertiary font-semibold text-primary-dark text-[0.875rem]">Published on {{ post_date }}</div>      
                                                {% if temp_content %}
                                                    <div class="font-tertiary font-normal text-primary-dark max-lg:text-[0.845625rem] text-[1.25rem] [&_p]:text-[1.25rem] max-lg:[&_p]:text-[0.845625rem]">{{ temp_result }}</div>
                                                {% endif %}
                                                <a href="{{ function('the_permalink', list.ID) }}" class="text-primary font-normal text-[1rem] flex items-center gap-[0.5rem]">
                                                    <span class="hidden max-lg:block">Read more </span>
                                                    <svg width="22" height="15" viewBox="0 0 22 15" fill="none" xmlns="http://www.w3.org/2000/svg">
                                                        <path d="M14.437 3.15531e-07L13.1648 1.27226L18.1997 6.3162L2.7609e-07 6.3162L3.54972e-07 8.12082L18.1997 8.12082L13.1557 13.1557L14.437 14.437L21.6555 7.21851L14.437 3.15531e-07Z" fill="#025294"/>
                                                    </svg>
                                                </a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                {% if image != "" %}
                                    <div class="~h-[29.375rem]/[46.0625rem] lg:w-[36.25rem] w-full overflow-hidden  rounded-bl-[8rem] ">
                                        <img src="{{ image }}" class="object-cover w-full h-full group-hover:scale-105 group-hover:transition-all group-hover:duration-300 group-hover:ease-in-out" />
                                    </div>
                                {% endif %}
                            </div>                            
                        {% endfor %}
                    </div>
                {% endif %}
            </div>

            {% if custom_query.max_num_pages > 1 %}
                {% set custom_class = 'ahr_loadmore btn bg-black text-white font-mono !no-underline !leading-[1rem] text-[0.875rem] cursor-pointer' %}						                
            
                <div id="load-more" class="flex items-center justify-center w-full">
                    <div class="ahr_loadmore btn btn-primary {{ custom_class }} w-auto">
                        Load more                        
                    </div>
                </div>
            {% endif %}
        </div>
    </div>

    <svg class="absolute z-0 top-0 left-0 object-cover w-full h-auto max-lg:hidden" width="1440" height="3079" viewBox="0 0 1440 3079" fill="none" xmlns="http://www.w3.org/2000/svg">
