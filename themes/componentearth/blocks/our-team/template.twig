{% set custom_class = "bg-[transparent]" %}

<section class="{{ block.slug ?? 'our-team' }} {{ custom_class }}">
    {% if fields.anchor|length > 0 or custom_id %}
        <div class="section-anchor" id="{{ custom_id ?? fields.anchor }}"></div>
    {% endif %}

    {% set pt = fields.padding_top and fields.padding_top != "unset" ? fields.padding_top : "st-md" %}
    {% set pb = fields.padding_top and fields.padding_bottom != "unset" ? fields.padding_bottom : "sb-md" %}

    <div class="container">
        <div class="{{ pt }} {{ pb }} flex flex-col ~gap-[3.5rem]/[5rem]">                                 
            <div class="flex flex-col items-center gap-sm mx-auto xl:max-w-[59.1875rem] lg:max-w-[67.1875rem]">
                {% if fields.title %}
                    <h2 class="text-center text-[var(--theme-color-dark)] font-tertiary w-full [&_p]:!~text-[3rem]/[6rem] [&_p]:leading-none [&_p_strong]:text-[var(--theme-color)] [&_p_strong]:font-normal">{{ fields.title }}</h2>
                {% endif %}

                {% if fields.paragraph %}
                    <div class="text-center max-lg:text-left font-normal [&_p]:font-tertiary-500 [&_p]:leading-[110%] [&_p]:text-[1.5rem] flex flex-col gap-[1.25rem] text-[var(--theme-color-dark)] [&_strong]:bg-[var(--theme-color)] [&_strong]:p-[0.25rem] [&_strong]:font-normal [&_strong]:text-white">{{ fields.paragraph }}</div>
                {% endif %}
            </div>  
            {% set ctr = 0 %}                   
            <div class="flex flex-col items-start gap-xl mx-auto text-start max-lg:mx-0" x-data="{ currentTab: {{ ctr }} }">
                {% for member in fields.team %}
                    {% set ctr = ctr + 1 %}
                    <div class="flex flex-col gap-[2rem] w-full" >
                        <div class="flex max-lg:flex-col ~gap-[1rem]/[1.5rem] max-lg:w-full 2xl:px-[10rem]" x-show="currentTab !== {{ ctr }}">
                        
                            <div class="flex max-lg:flex-col lg:gap-[1.75rem] gap-[1rem] lg:w-[40%] lg:items-center">
                                <div class="flex flex-col gap-[0.25rem] text-left lg:w-1/2 max-lg:max-w-[30rem] max-h-[11rem] max-lg:max-h-[21.1875rem] bg-cover bg-center bg-no-repeat rounded-br-[5rem] rounded-tl-[0.75rem] rounded-tr-[0.75rem] rounded-bl-[0.75rem]" style="background-image: url({{ member.image.url }})">
                                    <img class="invisible w-full h-full object-cover" src="{{ member.image.url }}" alt="featured-image" />
                                </div>

                                <div class="flex flex-col gap-[0.25rem] text-left lg:w-1/2">
                                    <p class="text-[var(--theme-color-dark)] text-[1.5rem] leading-none tracking-[-2%]">{{ member.position }}</p>
                                    <p class="text-[var(--theme-color-dark)] text-[1.125rem] leading-[1.6875rem]">{{ member.name }}</p>
                                </div>
                            </div>

                            {% if member.bio_excerpt %}
                                <div class="lg:w-[60%] flex flex-col gap-[0.5rem] items-end">
                                    <div class="lg:flex hidden font-normal text-left [&_p]:font-tertiary-500 [&_p]:leading-[1.6875rem] [&_p]:text-[1.125rem] flex-col text-[#3F3F3F] [&_strong]:font-tertiary-600">
                                        {{ member.bio_excerpt }}
                                    </div>

                                    <button x-on:click="currentTab = {{ ctr }}" class="text-[var(--theme-color)] font-tertiary-500">Read More</button>
                                </div>
                            {% endif %}
                        </div>

                        <div class="flex max-lg:flex-col ~gap-[1rem]/[1.5rem] max-lg:w-full relative 2xl:pl-[10rem]" x-show="currentTab === {{ ctr }}">             

                            <div class="bg-[#C0D5EA] w-full absolute lg:top-0 top-[19.1875rem] left-0 lg:h-[5.5rem] h-[7rem] z-[-1] before:content-[''] 
                                before:bg-[#C0D5EA] before:w-full before:absolute before:top-0 before:-left-full before:lg:h-[5.5rem] before:h-[7rem]
                                after:bg-[#C0D5EA] after:w-full after:absolute after:top-0 after:-right-full after:lg:h-[5.5rem] after:h-[7rem]"></div>

                            <div class="flex max-lg:flex-col gap-[1.75rem] 2xl:w-[33.5%] lg:w-[39.5%] max-h-[21.1875rem] lg:items-start max-lg:max-w-[30rem] bg-cover bg-center bg-no-repeat rounded-br-[5rem] rounded-tl-[0.75rem] rounded-tr-[0.75rem] rounded-bl-[0.75rem] overflow-hidden" style="background-image: url({{ member.image.url }})">
                                <img class="invisible w-full h-full object-cover" src="{{ member.image.url }}" alt="featured-image" />
                            </div>

                            {% if member.bio %}
                                <div class="lg:w-[60%] flex flex-col lg:gap-[0.5rem] gap-[1.5rem] items-start">

                                    <div class="flex flex-col gap-[0.25rem] text-left lg:py-[1.275rem]">
                                        <p class="text-[var(--theme-color-dark)] text-[1.5rem] leading-none tracking-[-2%]">{{ member.position }}</p>
                                        <p class="text-[var(--theme-color-dark)] text-[1.125rem] leading-[1.6875rem]">{{ member.name }}</p>
                                    </div>

                                    <div class="flex gap-[1rem] font-normal text-left [&_p]:font-tertiary-500 [&_p]:leading-[1.6875rem] [&_p]:text-[1.125rem] flex-col text-[#3F3F3F] [&_strong]:font-tertiary-600">
                                        {{ member.bio }}
                                    </div>

                                    {% if member.quote %}
                                        <div class="mt-[1rem] [&_p]:text-[2.5rem] [&_p]:leading-[90%] [&_p]:tracking-[-2%] [&_p]:text-primary-dark [&_strong]:font-normal [&_strong]:p-[0.25rem] [&_strong]:bg-[var(--theme-color-highlight)]">{{ member.quote }}</div>
                                    {% endif %}
                                </div>
                            {% endif %}
                        </div>                        
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>
</section>