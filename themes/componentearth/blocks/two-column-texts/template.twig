{% set custom_class = "bg-[#C0D5EA]" %}

<section class="{{ block.slug ?? 'two-column-texts' }} {{ custom_class }}">
    {% if fields.anchor|length > 0 or custom_id %}
        <div class="section-anchor" id="{{ custom_id ?? fields.anchor }}"></div>
    {% endif %}

    {% set pt = fields.padding_top and fields.padding_top != "unset" ? fields.padding_top : "st-xl" %}
    {% set pb = fields.padding_top and fields.padding_bottom != "unset" ? fields.padding_bottom : "sb-xl" %}

    <div class="container">
        <div class="{{ pt }} {{ pb }}">                                 
            <div class="flex flex-col items-start gap-sm">
                
                {% if fields.heading %}
                    <{{ fields.heading.type }} class="2xl:w-[36.6875rem] lg:w-1/2 w-full leading-[90%] text-[var(--theme-color-dark)] font-tertiary-700 [&_p]:!~text-[2.625rem]/[5.15625rem] [&_p]:leading-none [&_strong]:bg-[#FABC6F] [&_strong]:p-[0.25rem] [&_strong]:font-normal [&_strong]:text-primary-dark max-lg:text-left">
                        {{ fields.heading.value }}
                    </{{ fields.heading.type }}>
                {% endif %}


                {% if fields.content %}
                    <div class="grid {% if fields.content|length == 2 %} lg:grid-cols-2 {% else %} lg:grid-cols-1 {% endif %} gap-[2rem] w-full">
                        {% for content in fields.content %}
                            <div class="text-left font-normal [&_p]:font-tertiary [&_p]:leading-normal [&_p]:tracking-[-2%] [&_p]:text-[0.9375rem] flex flex-col gap-[1.25rem] text-primary-dark [&_strong]:bg-primary [&_strong]:p-[0.25rem] [&_strong]:font-normal [&_strong]:text-white w-full">
                                {{ content.paragraph }}
                            </div>
                        {% endfor %}
                    </div>
                {% endif %}
            </div>     
        </div>
    </div>
</section>