{% set pt = fields.padding_top and fields.padding_top != "unset" ? fields.padding_top : "st-xxl" %}
{% set pb = fields.padding_bottom and fields.padding_bottom != "unset" ? fields.padding_bottom : "sb-xxl" %}
{% set bg_class = 'bg-[#1A3850]' %}

<section class="{{ block.slug }} {{ bg_class }}">
  {% if block.anchor %}
    <div class="section-anchor" id="{{ block.anchor | default(block.id) }}"></div>
  {% endif %}

  <div class="container-fluid overflow-hidden lg:h-[23.4375rem] max-lg:px-0">
    <div class="relative flex flex-col items-center justify-center w-full h-full">
      <div class="relative h-full gap-y-0 z-50 w-full max-lg:px-0 max-lg:py-[5rem]">        
        <div class="container h-full">
          <div class="transition-top-stagger1 h-full flex flex-col items-start justify-center gap-sm" data-custom-delay="1.25" data-custom-stagger="0.25">            
            {% if fields.paragraph|length > 0 %}       
              <div class="para flex flex-col items-start max-w-[35.75rem] !pt-0 gap-md">
                <div class="flex flex-col gap-[1rem]">
                  <h4 class="para-desc text-[#DBD5C6] [&_p]:text-[1.5rem] [&_p]:leading-[120%]">{{ fields.paragraph }}</h4>
                  <p class="text-[#DBD5C6] text-[1.5rem]">{{ fields.subtext }}</p>
                </div>
              </div>                
            {% endif %}
          </div>
        </div>
      </div>
      <div class="absolute top-0 left-0 w-full h-full z-10">
        <svg class="object-cover w-full h-full" width="1440" height="375" viewBox="0 0 1440 375" fill="none" xmlns="http://www.w3.org/2000/svg">
          <g opacity="0.4" clip-path="url(#clip0_3562_1519)">
          <foreignObject x="2" y="-5.48248" width="52.876" height="386.959"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(2px);height:100%;width:100%"></div></foreignObject><path data-figma-bg-blur-radius="4" d="M50 -1C23.4693 47.1645 7 114.386 7 188.755C7 262.35 23.1283 328.946 49.1749 377" stroke="#DBD5C6" stroke-width="2"/>
          <foreignObject x="443" y="-5.49101" width="53.8711" height="386.976"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(2px);height:100%;width:100%"></div></foreignObject><path data-figma-bg-blur-radius="4" d="M492 -1C464.852 47.1645 448 114.386 448 188.755C448 262.35 464.503 328.946 491.156 377" stroke="#DBD5C6" stroke-width="2"/>
          <foreignObject x="890" y="-5.49101" width="53.8711" height="386.976"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(2px);height:100%;width:100%"></div></foreignObject><path data-figma-bg-blur-radius="4" d="M939 -1C911.852 47.1645 895 114.386 895 188.755C895 262.35 911.503 328.946 938.156 377" stroke="#DBD5C6" stroke-width="2"/>
          <foreignObject x="1213" y="-5.48248" width="52.876" height="386.959"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(2px);height:100%;width:100%"></div></foreignObject><path data-figma-bg-blur-radius="4" d="M1261 -1C1234.47 47.1645 1218 114.386 1218 188.755C1218 262.35 1234.13 328.946 1260.17 377" stroke="#DBD5C6" stroke-width="2"/>
          <foreignObject x="847.124" y="-5.47656" width="52.876" height="386.959"><div xmlns="http://www.w3.org/1999/xhtml" style="backdrop-filter:blur(2px);height:100%;width:100%"></div></foreignObject><path data-figma-bg-blur-radius="4" d="M852 377C878.531 328.836 895 261.614 895 187.245C895 113.65 878.872 47.0545 852.825 -1.00002" stroke="#DBD5C6" stroke-width="2"/>
          </g>
          <defs>
          <clipPath id="clip0_3562_1519">
          <rect width="1440" height="375" fill="white"/>
          </clipPath>
          </defs>
        </svg>
      </div>
      
      <div class="absolute top-0 left-0 w-full h-full z-0" data-custom-delay="0" data-custom-stagger="0.25">        
          {% if fields.thumbnail %}  
            {% set image = fields.thumbnail ? fields.thumbnail.url : function('png', 'default') %}  
            {% set image_mobile = fields.thumbnail_mobile ? fields.thumbnail_mobile.url : image %}  
            
            <div data-jarallax data-speed="0.75" class="jarallax w-full h-full">            
              <img class="jarallax-img lg:block hidden" src="{{ image }}" alt="banner-image" />        
              <img class="jarallax-img lg:hidden block" src="{{ image_mobile }}" alt="banner-image-mobile" />        
            </div>
          {% endif %}         
      </div>
    </div>
  </div>
</section>


